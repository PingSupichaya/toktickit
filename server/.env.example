# Copy this file to ".env" and fill in your own local values.
# Do NOT commit your real .env file.
DATABASE_URL="postgresql://toktickit:toktickit@localhost:5433/toktickit?schema=public"
PORT=3000

# Comma-separated browser origins allowed to call the API with credentials.
# Defaults to the Vite dev server. CSRF asks state-changing requests to present
# an Origin (or Referer) from this list.
TRUSTED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Set to "true" only in non-local environments to add the Secure attribute to
# the session cookie.
COOKIE_SECURE="false"