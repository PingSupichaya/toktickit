// Prisma schema — datasource and generator are pre-wired.
// Your DATABASE_URL lives in server/.env (copy it from .env.example).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Lab 3 — Real users, authentication, IT Staff queue, User Management
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  REQUESTER
  IT_STAFF
  ADMIN
}

enum RequestedPriority {
  LOW
  MEDIUM
  HIGH
}

enum TicketStatus {
  NEW
  OPEN
  IN_PROGRESS
  WAITING_FOR_REQUESTER
  RESOLVED
  CLOSED
  REOPENED
  CANCELLED
}

// ---------------------------------------------------------------------------
// Reference data (unchanged from Lab 2)
// ---------------------------------------------------------------------------

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tickets Ticket[]

  @@map("category")
}

model RelatedSystem {
  id       Int     @id @default(autoincrement())
  name     String  @unique
  isActive Boolean @default(true)

  tickets Ticket[]

  @@map("related_system")
}

// ---------------------------------------------------------------------------
// User (replaces the Lab 2 Requester model; table `user`)
// ---------------------------------------------------------------------------

model User {
  id                  Int       @id @default(autoincrement())
  name                String
  email               String    @unique
  role                UserRole
  isActive            Boolean   @default(true)
  passwordHash        String
  mustChangePassword  Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  lastFailedLoginAt   DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  submittedTickets Ticket[]         @relation("submittedTickets")
  ownedTickets     Ticket[]         @relation("ownedTickets")
  sessions         Session[]
  publicComments   PublicComment[]
  internalNotes    InternalNote[]

  @@index([isActive])
  @@index([role])
  @@map("user")
}

// ---------------------------------------------------------------------------
// Session (8-hour opaque cookie token, SHA-256 hashed)
// ---------------------------------------------------------------------------

model Session {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

// ---------------------------------------------------------------------------
// Ticket (Lab 2 ticket; owner, IT Priority, expanded status)
// ---------------------------------------------------------------------------

model Ticket {
  id                Int               @id @default(autoincrement())
  ticketNumber      String            @unique
  submittedById     Int
  ownerId           Int?
  categoryId        Int
  relatedSystemId   Int
  summary           String
  description       String
  requestedPriority RequestedPriority
  itPriority        RequestedPriority
  currentStatus     TicketStatus      @default(NEW)
  ticketDate        DateTime          @default(now())
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  submitter       User             @relation("submittedTickets", fields: [submittedById], references: [id])
  owner           User?            @relation("ownedTickets", fields: [ownerId], references: [id])
  category        Category         @relation(fields: [categoryId], references: [id])
  relatedSystem   RelatedSystem    @relation(fields: [relatedSystemId], references: [id])
  attachments     Attachment[]
  publicComments  PublicComment[]
  internalNotes   InternalNote[]

  @@index([submittedById])
  @@index([ownerId])
  @@index([itPriority])
  @@index([ticketDate])
  @@index([currentStatus])
  @@index([categoryId])
  @@index([relatedSystemId])
  @@index([submittedById, ticketDate])
  @@index([itPriority, ticketDate])
  @@index([currentStatus, ticketDate])
  @@map("ticket")
}

// ---------------------------------------------------------------------------
// Attachment (unchanged from Lab 2; soft-removal)
// ---------------------------------------------------------------------------

model Attachment {
  id               Int       @id @default(autoincrement())
  ticketId         Int
  originalFilename String
  storedFilename   String
  fileSizeBytes    Int
  contentType      String
  uploadedAt       DateTime  @default(now())
  isRemoved        Boolean   @default(false)
  removedAt        DateTime?
  removalReason    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  ticket           Ticket    @relation(fields: [ticketId], references: [id])

  @@index([ticketId])
  @@index([ticketId, isRemoved])
  @@map("attachment")
}

// ---------------------------------------------------------------------------
// Public Comment (visible to the Requester; 1-2000 chars)
// ---------------------------------------------------------------------------

model PublicComment {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  authorId  Int
  content   String
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id])
  author User   @relation(fields: [authorId], references: [id])

  @@index([ticketId])
  @@index([ticketId, createdAt])
  @@map("public_comment")
}

// ---------------------------------------------------------------------------
// Internal Note (staff-only; 1-2000 chars)
// ---------------------------------------------------------------------------

model InternalNote {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  authorId  Int
  content   String
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id])
  author User   @relation(fields: [authorId], references: [id])

  @@index([ticketId])
  @@index([ticketId, createdAt])
  @@map("internal_note")
}